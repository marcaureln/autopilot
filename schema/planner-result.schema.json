{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/marcaureln/autopilot/main/schema/planner-result.schema.json",
  "title": "Autopilot planner result",
  "description": "What the planner writes to /work/.autopilot/result.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["needs_info", "questions", "scope", "risk", "planned_files", "spec"],
  "properties": {
    "needs_info": { "type": "boolean" },
    "questions": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "scope": { "enum": ["ok", "too_broad"] },
    "risk": { "enum": ["low", "high"] },
    "planned_files": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "status"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "status": { "enum": ["added", "modified", "deleted"] }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "status", "previous_path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "status": { "const": "renamed" },
              "previous_path": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "spec": { "type": "string", "minLength": 1, "maxLength": 40000 }
  },
  "if": { "properties": { "needs_info": { "const": true } } },
  "then": { "properties": { "questions": { "type": "array", "minItems": 1 } } }
}
